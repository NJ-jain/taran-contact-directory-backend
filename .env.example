# ==============================================
# Backend Server Configuration
# ==============================================
PORT=5000
NODE_ENV=development

# ==============================================
# Database Configuration (MongoDB)
# ==============================================
# Local MongoDB: mongodb://localhost:27017/taran_contact_directory
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/taran_contact_directory?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/taran_contact_directory

# ==============================================
# Authentication & Security
# ==============================================
# Secret key for JWT generation and verification
JWT_SECRET=your_jwt_super_secret_key_change_this_in_production
# Dedicated admin JWT secret (falls back to JWT_SECRET if not provided)
ADMIN_JWT_SECRET=your_admin_jwt_super_secret_key
# Secret required to register a new admin account
ADMIN_REGISTRATION_SECRET=your_admin_invite_secret_key

# ==============================================
# Frontend Application URL & Allowed Origins
# ==============================================
# Local: http://localhost:3000
# Production: https://www.taran.co.in
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://www.taran.co.in,https://taran.co.in

# ==============================================
# Email Configuration (Nodemailer / Gmail)
# ==============================================
# Option 1: Gmail App Password
EMAIL_USER=your_email@gmail.com
GOOGLE_APP_PASSWORD=your_google_app_password

# Option 2: Gmail OAuth 2.0 (alternative)
# GMAIL_CLIENT_ID=your_gmail_oauth_client_id
# GMAIL_CLIENT_SECRET=your_gmail_oauth_client_secret
# GMAIL_REFRESH_TOKEN=your_gmail_oauth_refresh_token
# GMAIL_ACCESS_TOKEN=your_gmail_oauth_access_token

# ==============================================
# ImageKit Configuration (Image Storage & CDN)
# ==============================================
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
