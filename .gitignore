# ==========================================
# Backend Git Ignore Rules
# ==========================================

# Dependencies
node_modules/
/.pnp
.pnp.js

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
# Exception: Always track example configuration
!.env.example

# Private Keys & Certificates
*.pem
*.key
*.cert
*.crt

# Runtime, Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
*.log
pids/
*.pid
*.seed
*.pid.lock

# Test Coverage
coverage/
.nyc_output/

# Build & Deployments
dist/
build/
.vercel/

# Local uploads & cache
uploads/
temp/
tmp/
.cache/

# OS Specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Specific
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Legacy / sensitive scripts
setup-env.js
